#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require "json"
require "uri"
require "ipaddr"

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
BASE_URL = (ENV["MOVES_API_URL"] || "http://127.0.0.1:3000").chomp("/")
TOKEN    = ENV["MOVES_API_TOKEN"]

USAGE = <<~USAGE
  Moves CLI — thin client for the Moves JSON API

  Usage:
    moves list                                  List all moves (id, title, recommendation)
    moves today                                 Show today's focus moves
    moves show ID                               Show details for a specific move
    moves add "Title" [OPTIONS]                 Create a new move
    moves delegate ID --to AGENT               Delegate a move to an agent (scope: moves:write)
    moves queue [--state STATE]                 Poll agent's delegation queue (scope: delegation:read)
    moves claim ID                              Atomically claim a delegated move (scope: delegation:write)
    moves report ID --status STATUS [--result R] Report progress/outcome (scope: delegation:write)

  Options for 'add':
    --effort N        Effort in minutes (10/30/60/120/240/480/960)
    --probability P   Subjective probability (10/25/40/60/75/90)
    --payoff X        Payoff value normalized (1/2/3/5/8/13)

  Options for 'delegate':
    --to AGENT        Name of the agent to delegate to (e.g. darwin)

  Options for 'queue':
    --state STATE     Filter by delegation_state (default: delegated)

  Options for 'report':
    --status STATUS   One of: in_progress, done, blocked
    --result TEXT     Optional result text

  Environment:
    MOVES_API_URL     Base URL (default: http://127.0.0.1:3000)
    MOVES_API_TOKEN   Bearer token (required)
USAGE

# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------
# True for localhost, the whole 127.0.0.0/8 block, and IPv6 ::1 (URI#host returns
# it bracketed as "[::1]"). Uses a real IP parse so a hostname that merely starts
# with "127." (e.g. "127.example.com") is NOT treated as loopback.
def loopback?(host)
  h = host.to_s.downcase.delete_prefix("[").delete_suffix("]")
  return true if h == "localhost"

  IPAddr.new(h).loopback?
rescue IPAddr::InvalidAddressError
  false
end

def api_request(method, path, body: nil)
  if TOKEN.nil? || TOKEN.strip.empty?
    warn "Error: MOVES_API_TOKEN environment variable is not set."
    warn "  Generate a token with: bin/rails moves:token:mint[name,scopes]"
    exit 1
  end

  uri = URI.parse("#{BASE_URL}#{path}")

  # Never send the bearer token over plaintext HTTP to a non-loopback host — a
  # later HTTPS redirect can't protect a token already sent in the clear. Only
  # loopback may use http (local dev); override deliberately with MOVES_ALLOW_INSECURE=1.
  if uri.scheme != "https" && !loopback?(uri.host) && ENV["MOVES_ALLOW_INSECURE"] != "1"
    warn "Error: refusing to send a token over plaintext HTTP to #{uri.host}."
    warn "  Use an https:// MOVES_API_URL (or MOVES_ALLOW_INSECURE=1 for deliberate local testing)."
    exit 1
  end

  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == "https"

  request_class = {
    get:    Net::HTTP::Get,
    post:   Net::HTTP::Post,
    patch:  Net::HTTP::Patch,
    delete: Net::HTTP::Delete
  }[method]
  req = request_class.new(uri.request_uri)
  req["Authorization"] = "Bearer #{TOKEN}"
  req["Accept"]        = "application/json"

  if body
    req["Content-Type"] = "application/json"
    req.body = JSON.generate(body)
  end

  response = http.request(req)
  parsed   = JSON.parse(response.body) rescue {}
  [ response.code.to_i, parsed ]
end

def handle_error(code, body)
  err = body.is_a?(Hash) ? body.dig("error", "message") : body.to_s
  warn "Error #{code}: #{err}"
  exit 1
end

# ---------------------------------------------------------------------------
# Formatters
# ---------------------------------------------------------------------------
def print_move_row(m)
  rec = m["recommendation"].to_s.ljust(12)
  printf "  %-6s  %-12s  %s\n", m["id"], rec, m["title"]
end

def print_move_detail(m)
  puts ""
  puts "  ID:           #{m['id']} (uuid: #{m['uuid']})"
  puts "  Title:        #{m['title']}"
  puts "  Stage:        #{m['stage']}  |  Type: #{m['move_type']}"
  puts "  Rec:          #{m['recommendation']}  |  EV: #{m['ev_score']}"
  puts "  Effort:       #{m['effort_minutes']} min"
  puts "  Probability:  #{m['subjective_probability']}%"
  puts "  Payoff:       #{m['payoff_value_normalized']} (#{m['payoff_type']})"
  puts "  Due:          #{m['due_date'] || 'none'}"
  puts "  Description:  #{m['description'] || '—'}"

  d = m["delegation"]
  if d && d["delegation_state"] != "none"
    puts "  Delegation:"
    puts "    Assignee:  #{d['assignee']}"
    puts "    State:     #{d['delegation_state']}"
    puts "    ID:        #{d['delegation_id']}"
    puts "    Result:    #{d['delegation_result'] || '—'}"
    puts "    Delegated: #{d['delegated_at'] || '—'}"
    puts "    Reported:  #{d['reported_at'] || '—'}"
  end
  puts ""
end

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------
def cmd_list
  code, body = api_request(:get, "/api/v1/moves")
  handle_error(code, body) unless code == 200

  moves = body["moves"] || []
  meta  = body["meta"]  || {}
  puts "Moves (#{meta['total']} total, page #{meta['page']}):"
  puts ""
  printf "  %-6s  %-12s  %s\n", "ID", "RECOMMEND.", "TITLE"
  puts "  " + "-" * 60
  moves.each { |m| print_move_row(m) }
  puts ""
end

def cmd_today
  code, body = api_request(:get, "/api/v1/today")
  handle_error(code, body) unless code == 200

  moves = body["moves"] || []
  puts "Today's focus (#{moves.size} moves):"
  puts ""
  printf "  %-6s  %-12s  %s\n", "ID", "RECOMMEND.", "TITLE"
  puts "  " + "-" * 60
  moves.each { |m| print_move_row(m) }
  puts ""
end

def cmd_show(id)
  unless id
    warn "Usage: moves show ID"
    exit 1
  end
  code, body = api_request(:get, "/api/v1/moves/#{id}")
  handle_error(code, body) unless code == 200
  print_move_detail(body)
end

def cmd_add(args)
  title       = args.shift
  effort      = nil
  probability = nil
  payoff      = nil

  until args.empty?
    flag = args.shift
    val  = args.shift
    case flag
    when "--effort"      then effort      = val&.to_i
    when "--probability" then probability = val&.to_i
    when "--payoff"      then payoff      = val&.to_i
    else
      warn "Unknown option: #{flag}"
      exit 1
    end
  end

  unless title
    warn "Usage: moves add \"Title\" [--effort N] [--probability P] [--payoff X]"
    exit 1
  end

  payload = { move: { title: title } }
  payload[:move][:effort_minutes]           = effort      if effort
  payload[:move][:subjective_probability]   = probability if probability
  payload[:move][:payoff_value_normalized]  = payoff      if payoff

  code, body = api_request(:post, "/api/v1/moves", body: payload)
  handle_error(code, body) unless code == 201

  puts "Move created:"
  print_move_detail(body)
end

def cmd_delegate(args)
  id  = args.shift
  to  = nil

  until args.empty?
    flag = args.shift
    val  = args.shift
    case flag
    when "--to" then to = val
    else
      warn "Unknown option: #{flag}"
      exit 1
    end
  end

  unless id && to
    warn "Usage: moves delegate ID --to AGENT"
    exit 1
  end

  code, body = api_request(:post, "/api/v1/moves/#{id}/delegate", body: { assignee: to })
  handle_error(code, body) unless code == 200

  puts "Move delegated to '#{to}':"
  puts "  delegation_id: #{body.dig('delegation', 'delegation_id')}"
  print_move_detail(body)
end

def cmd_queue(args)
  state = "delegated"

  until args.empty?
    flag = args.shift
    val  = args.shift
    case flag
    when "--state" then state = val
    else
      warn "Unknown option: #{flag}"
      exit 1
    end
  end

  code, body = api_request(:get, "/api/v1/delegations?state=#{URI.encode_uri_component(state)}")
  handle_error(code, body) unless code == 200

  moves = body["moves"] || []
  puts "Delegation queue (state=#{state}, #{moves.size} moves):"
  puts ""
  printf "  %-6s  %-24s  %-16s  %s\n", "ID", "DELEGATION_ID", "STATE", "TITLE"
  puts "  " + "-" * 70
  moves.each do |m|
    d = m["delegation"] || {}
    printf "  %-6s  %-24s  %-16s  %s\n",
           m["id"], d["delegation_id"].to_s[0, 22], d["delegation_state"], m["title"]
  end
  puts ""
end

def cmd_claim(id)
  unless id
    warn "Usage: moves claim ID"
    exit 1
  end

  code, body = api_request(:post, "/api/v1/moves/#{id}/claim")
  if code == 200
    puts "Move claimed:"
    print_move_detail(body)
  elsif code == 409
    warn "Conflict: #{body.dig('error', 'message')}"
    exit 1
  else
    handle_error(code, body)
  end
end

def cmd_report(args)
  id            = args.shift
  status        = nil
  result        = nil
  delegation_id = nil

  until args.empty?
    flag = args.shift
    val  = args.shift
    case flag
    when "--status"        then status        = val
    when "--result"        then result        = val
    when "--delegation-id" then delegation_id = val
    else
      warn "Unknown option: #{flag}"
      exit 1
    end
  end

  unless id && status && delegation_id
    warn "Usage: moves report ID --delegation-id ID --status done|blocked|in_progress [--result TEXT]"
    warn "  (get the delegation-id from `moves queue` or the claim response)"
    exit 1
  end

  payload = { delegation_id: delegation_id, status: status, result: result.to_s }
  code, body = api_request(:post, "/api/v1/moves/#{id}/delegation/callback", body: payload)

  if code == 200
    puts "Reported '#{status}':"
    print_move_detail(body)
  elsif code == 409
    warn "Conflict: #{body.dig('error', 'message')}"
    exit 1
  else
    handle_error(code, body)
  end
end

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
subcommand = ARGV.shift

case subcommand
when "list"     then cmd_list
when "today"    then cmd_today
when "show"     then cmd_show(ARGV.shift)
when "add"      then cmd_add(ARGV.dup)
when "delegate" then cmd_delegate(ARGV.dup)
when "queue"    then cmd_queue(ARGV.dup)
when "claim"    then cmd_claim(ARGV.shift)
when "report"   then cmd_report(ARGV.dup)
when nil, "--help", "-h"
  puts USAGE
else
  warn "Unknown subcommand: #{subcommand}"
  warn ""
  warn USAGE
  exit 1
end
